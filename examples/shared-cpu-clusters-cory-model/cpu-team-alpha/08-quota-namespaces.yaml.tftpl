apiVersion: v1
kind: Namespace
metadata:
  name: team-alpha
---
apiVersion: v1
kind: Namespace
metadata:
  name: team-beta
---
# 1. Default ClusterQueue: 0 nominal quota, 100% borrowing capacity across the cohort
apiVersion: kueue.x-k8s.io/v1beta2
kind: ClusterQueue
metadata:
  name: default-cq
spec:
  cohortName: ${cohort_name}
  namespaceSelector: {}
  preemption:
    reclaimWithinCohort: Any
    borrowWithinCohort:
      policy: LowerPriority
    withinClusterQueue: LowerPriority
  resourceGroups:
    - coveredResources: ["cpu", "memory"]
      flavors:
        - name: cpu-shared-flavor
          resources:
            - name: "cpu"
              nominalQuota: "0"
              borrowingLimit: "${total_cpu_capacity}"
            - name: "memory"
              nominalQuota: "0"
              borrowingLimit: "${total_memory_capacity}"
---
# 2. Team Alpha ClusterQueue: Nominal quota owner (can reclaim 100% of its nominal share anytime)
apiVersion: kueue.x-k8s.io/v1beta2
kind: ClusterQueue
metadata:
  name: team-alpha-cq
spec:
  cohortName: ${cohort_name}
  namespaceSelector: {}
  preemption:
    reclaimWithinCohort: Any
    borrowWithinCohort:
      policy: LowerPriority
    withinClusterQueue: LowerPriority
  resourceGroups:
    - coveredResources: ["cpu", "memory"]
      flavors:
        - name: cpu-shared-flavor
          resources:
            - name: "cpu"
              nominalQuota: "${team_alpha_nominal_cpu}"
            - name: "memory"
              nominalQuota: "${team_alpha_nominal_memory}"
---
# 3. Team Beta ClusterQueue: Nominal quota owner
apiVersion: kueue.x-k8s.io/v1beta2
kind: ClusterQueue
metadata:
  name: team-beta-cq
spec:
  cohortName: ${cohort_name}
  namespaceSelector: {}
  preemption:
    reclaimWithinCohort: Any
    borrowWithinCohort:
      policy: LowerPriority
    withinClusterQueue: LowerPriority
  resourceGroups:
    - coveredResources: ["cpu", "memory"]
      flavors:
        - name: cpu-shared-flavor
          resources:
            - name: "cpu"
              nominalQuota: "${team_beta_nominal_cpu}"
            - name: "memory"
              nominalQuota: "${team_beta_nominal_memory}"
---
apiVersion: kueue.x-k8s.io/v1beta2
kind: LocalQueue
metadata:
  name: default-lq
  namespace: default
spec:
  clusterQueue: default-cq
---
apiVersion: kueue.x-k8s.io/v1beta2
kind: LocalQueue
metadata:
  name: team-alpha-lq
  namespace: team-alpha
spec:
  clusterQueue: team-alpha-cq
---
apiVersion: kueue.x-k8s.io/v1beta2
kind: LocalQueue
metadata:
  name: team-beta-lq
  namespace: team-beta
spec:
  clusterQueue: team-beta-cq
